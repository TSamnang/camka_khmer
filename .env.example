# ==============================================================================
# FLASK APPLICATION CONFIGURATION
# ==============================================================================
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate_a_secure_random_key_here

# ==============================================================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ==============================================================================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/camkakhmer?retryWrites=true&w=majority

# ==============================================================================
# TELEGRAM BOT & NOTIFICATIONS
# ==============================================================================
# Security / System Error Alerts
TELEGRAM_DEV_BOT_TOKEN=your_dev_bot_token_here
TELEGRAM_DEV_CHAT_ID=@your_dev_channel_or_chat_id

# Customer Order Alerts
TELEGRAM_ORDER_BOT_TOKEN=your_order_bot_token_here
TELEGRAM_ORDER_CHAT_ID=@your_order_channel_or_chat_id

# ==============================================================================
# BAKONG KHQR PAYMENT CREDENTIALS
# ==============================================================================
BAKONG_TOKEN=your_nbc_developer_token_here
BAKONG_ACCOUNT_ID=your_account_id@bank
BAKONG_MERCHANT_NAME=Your Store Name
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_PHONE_NUMBER=012345678
BAKONG_STORE_LABEL=Cashier-01
BAKONG_TERMINAL_LABEL=POS-01

# ==============================================================================
# CORS & SESSION SECURITY
# ==============================================================================
CORS_ORIGINS=http://localhost:3200,https://yourdomain.com
SESSION_COOKIE_SECURE=True
